{
  "pipelineVersion": 5,
  "projectSchemaVersion": 3,
  "languageDefault": "de",
  "aspectRatio": "16:9",
  "fps": 30,
  "resolution": {"width": 1920, "height": 1080},
  "coverPolicy": {"firstSceneIsCover": true, "coverImageNumber": 1, "coverCandidateCount": 3, "separateThumbnailForbidden": true},
  "imagePolicy": {
    "fixedImageCountForbidden": true,
    "oneImageOneVisualPurpose": true,
    "targetAverageHoldSeconds": [2.4, 3.6],
    "highIntensityHoldSeconds": [1.4, 2.6],
    "breathingHoldSeconds": [3.6, 5.0],
    "targetImagesPer100Seconds": [30, 42],
    "reviewAboveSeconds": 4.8,
    "preferSplitAboveSeconds": 5.8,
    "hardMaximumSeconds": 8.0,
    "minimumUsefulHoldSeconds": 1.3,
    "multipleImagesPerSentenceAllowed": true
  },
  "introVisualPolicy": {
    "windowSeconds": 10,
    "minimumImageStartsInWindow": 4,
    "maximumCoverHoldSeconds": 3.0,
    "maximumAnyHoldSecondsInWindow": 4.5,
    "phase1ScriptCharacterWindow": 520
  },
  "flowProductionPolicy": {
    "batchSize": 5,
    "lastBatchMayBeSmaller": true,
    "generateWholeBatchBeforeNext": true,
    "individualDownloadForbidden": true,
    "manualRenameForbidden": true,
    "downloadAllOnceAfterGeneration": true,
    "automaticImportRequired": true,
    "batchFolderName": "5er-batches"
  },
  "assetPolicy": {"minimumWidth": 1280, "minimumHeight": 720, "targetAspectRatio": 1.7777778, "aspectRatioTolerance": 0.04, "minimumImageBytes": 20000, "duplicateImagesForbidden": true},
  "audioPolicy": {"playbackRate": 1.08, "silenceThresholdDb": -36, "minimumLongPauseSeconds": 0.35, "retainedPauseSeconds": 0.12, "loudnessTargetLufs": -16, "truePeakDbtp": -1.5, "loudnessRangeLra": 11, "outputSampleRateHz": 48000, "userOriginalMustRemainUntouched": true},
  "alignmentPolicy": {"defaultModel": "small", "minimumConfidence": 0.70, "maxFirstAnchorSeconds": 6.0, "windowTokenSlack": 2},
  "endHoldPolicy": {"minimumSeconds": 1.2, "targetSeconds": 1.3, "maximumSeconds": 1.5},
  "renderPolicy": {"codec": "h264", "crf": 18, "durationToleranceSeconds": 0.20, "minimumVideoBytes": 150000},
  "motionPolicy": {"defaultStrength": 1.0, "allowedTypes": ["push-in", "pull-out", "pan-left", "pan-right", "drift-up", "drift-down", "focus-left", "focus-right", "still"]}
}
