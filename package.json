{
  "name": "verueckte-stickman-video-pipeline",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "description": "German role-based Stickman entertainment pipeline with format-aware scripting, adaptive visuals, Flow batches, audio alignment, render QC, YouTube caption export and timed transcript export.",
  "scripts": {
    "create:video": "node src/cli/create-project.js",
    "topic:video": "node src/cli/check-topic.js",
    "compile:flow": "node src/cli/compile-flow-prompt.js",
    "import:flow-images": "node src/cli/import-flow-images.js",
    "validate:phase1": "node src/cli/validate-phase1-v9.js",
    "validate:assets": "node src/cli/validate-assets.js",
    "optimize:audio": "node src/cli/optimize-audio.js",
    "align:audio": "node src/cli/auto-align.js",
    "build:timeline": "node src/cli/build-timeline.js",
    "validate:timeline": "node src/cli/validate-timeline.js",
    "render:video": "node src/cli/render.js",
    "finalize:video": "node src/cli/finalize.js",
    "phase3": "node src/cli/phase3.js",
    "studio": "remotion studio src/youtube-renderer/index.jsx",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@remotion/cli": "4.0.506",
    "@remotion/media": "4.0.506",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.506"
  },
  "engines": {"node": ">=22"}
}
